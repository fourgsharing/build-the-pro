rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — only the user themselves or leadership can read/write
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isLeadership());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && isLeadership();
    }

    // Mentors — leadership can manage, mentors can read their own
    match /mentors/{mentorId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isLeadership();
    }

    // Mentees — leadership can manage, mentors can manage their own mentees
    match /mentees/{menteeId} {
      allow read: if true; // mentees access via magic links (no auth)
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Responses — mentees can write (no auth via magic link), authenticated users can read
    match /responses/{responseId} {
      allow read: if true;
      allow create, update: if true; // mentees submit without auth
      allow delete: if request.auth != null;
    }

    // Invites — leadership creates, anyone can read (to validate during signup)
    match /invites/{code} {
      allow read: if true;
      allow create: if request.auth != null && isLeadership();
      allow update: if true; // marked used during signup
    }

    // Helper function to check leadership role
    function isLeadership() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'leadership';
    }
  }
}
